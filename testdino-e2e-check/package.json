{
  "name": "testdino-e2e-check",
  "version": "1.0.0",
  "private": true,
  "description": "QA project for TDV2-1087: e2e (TesterArmy) runs and Playwright runs reported to TestDino staging.",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  },
  "scripts": {
    "install:test-build": "npm install -D ./vendor/testdino-e2e-1.1.0.tgz && npm ls @testdino/e2e",
    "reset": "node scripts/reset-state.mjs",
    "e2e": "npm run reset && e2e run",
    "e2e:filtered": "npm run reset && e2e run --grep \"home page shows the header\"",
    "e2e:long": "npm run reset && E2E_LONG_TEST=1 e2e run e2e/long-running.e2e.ts",
    "pw": "playwright test",
    "pw:sharded": "node scripts/pw-sharded.mjs",
    "check:versions": "node -v && npm ls e2e @e2e-dev/web @testdino/e2e @playwright/test @testdino/playwright"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.15.3",
    "@playwright/test": "1.58.2",
    "@testdino/e2e": "^1.0.1",
    "@testdino/playwright": "^2.10.1",
    "@types/node": "^24.10.1",
    "e2e": "0.21.3"
  }
}
