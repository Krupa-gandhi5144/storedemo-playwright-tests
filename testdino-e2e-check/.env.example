# Copy to .env and fill in. Never commit .env.
# Staging project API key (project on lab.testdino.com → Settings → API keys)
TESTDINO_TOKEN=
# Staging ingestion server (TDV2-1087 "Before testing")
TESTDINO_SERVER_URL=https://stg-analytics.testdino.com
# Optional run tags for e2e runs (comma-separated); config tags (TD_TAGS) win over this
# TESTDINO_TAGS=tdv2-1087,e2e
# Storedemo base URL used by both suites
APP_URL=https://storedemo.testdino.com
